<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ki_pos_cash_in_out_receipt.CashMovePopup"
       t-inherit="point_of_sale.CashMovePopup"
       t-inherit-mode="extension">
        <xpath expr="//Dialog/div[hasclass('input-amount')]/div[hasclass('input-group')]/following-sibling::div[1]/Input" position="replace">
            <Input tModel="[state, 'amount']"
                icon="{type: 'string', value: getSelectedCurrency().symbol}"
                iconOnLeftSide="getSelectedCurrency().position === 'before'"
                isValid.bind="env.utils.isValidFloat"
                autofocus="true"
                getRef="(ref) => this.inputRef = ref" />
        </xpath>
        <xpath expr="//Dialog/div[hasclass('input-amount')]/div[hasclass('input-group')]" position="after">
            <div t-attf-class="{{this.ui.isSmall ? 'mw-50 h-50' : 'w-25'}}" style="padding-left: 10px;">
                <select class="form-select form-select-lg" t-model="cashCurrencyState.currency_id">
                    <t t-foreach="cash_currency_ids" t-as="currency" t-key="currency.id">
                        <option t-att-value="currency.id">
                            <t t-esc="currency.name"/>
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
    </t>
</templates>
