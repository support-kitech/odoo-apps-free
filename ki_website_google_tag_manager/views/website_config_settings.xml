<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_config_settings_tag_manager" model="ir.ui.view">
        <field name="name">Google Tag Manager: Website settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='website_info_settings']" position="inside">
                <setting id="google_tag_manager_setting">
                    <div class="content-group">
                        <label for="google_tag_manager_key"/>
                        <div name="google_tag_manager_key">
                            <div>
                                <div name="google_tag_manager_key" class="oe_inline">
                                    <field name="google_tag_manager_key" placeholder="GTM-XXXXXXX"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
