<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_website_whatsapp_inquiry" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.whatsapp.inquiry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="WhatsApp Inquiry Configuration" id="div_website_whatsapp_inquiry">
                    <setting
                        id="div_website_whatsapp_inquiry_message"
                        string="Add a message sent with product inquiries."
                    >
                        <field name="inquiry_message" widget="text"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
